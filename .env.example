# MahaSetu AI Environment Configuration
# Copy this file to .env for local development

# OpenAI API Key (Optional: App operates fully offline in DEMO MODE if omitted)
VITE_OPENAI_API_KEY=

# App Demo Mode Flag (Defaults to true for Hackathon evaluation)
VITE_ENABLE_DEMO_MODE=true

# API Setu Gateway Endpoint (Optional future production URL)
VITE_API_SETU_ENDPOINT=https://apisetu.gov.in/api/v1
